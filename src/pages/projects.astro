---
import "../styles/global.css"
import Navbar from '../components/Navbar.astro'
import Footer from "../components/Footer.astro"
import ProjectBlock from "../components/ProjectBlock.astro"
---

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Projects - Will Trojniak</title>
</head>

<body>
  <main class="min-h-lvh flex flex-col w-full">
    <Navbar/>
    <section class="flex-1 m-auto max-w-2xl w-full px-8">
      <h1 class="text-3xl font-semibold mb-4">Projects</h1>
      <dl class="mb-8 text-lg">
          <ProjectBlock title="Assassins" 
            repo_url="https://github.com/willtrojniak/assassins"
            website_url="https://assassins.wobbletop.xyz"
            technologies={["Python", "Flask", "SQLite"]}
            desc="A web application for organizing senior-year assassins game."
          />
          <ProjectBlock title="CaféTrackr" 
            repo_url="https://github.com/willtrojniak/TabAppBackend"
            website_url="https://tabapp.wobbletop.xyz"
            technologies={["Go", "PostgreSQL", "React"]}
            desc="A web application for tracking group orders at café-like shops for later invoicing."
          />
          <ProjectBlock title="Froth" 
            repo_url="https://github.com/willtrojniak/froth"
            technologies={["C++", "Vulkan"]}
            desc="Cross platform realtime-rendering engine using Vulkan."
          />
          <ProjectBlock title="Flipp.nvim" 
            repo_url="https://github.com/willtrojniak/flipp.nvim"
            technologies={["Lua"]}
            desc="C/C++ Neovim plugin for generating function definitions from their declarations."
          />
          <ProjectBlock title="Homegoing" 
            repo_url="https://github.com/willtrojniak/homegoing"
            technologies={["Go"]}
            desc="Lightweight TUI application for managing user 'dotfiles' through file symlinks."
          />
      </dl>
    </section>
    <Footer/>
  </main>
</body>

</html>
